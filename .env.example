# ==== Supabase（Supabase 控制台 → Project Settings → API）====
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon public key：可以放前端公开，但本项目只在服务端用
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
# 可选但推荐：service_role key，可绕过 RLS，只在服务端使用，绝不能泄漏到前端
SUPABASE_SERVICE_ROLE_KEY=

# ==== 模型（默认豆包 / 火山方舟，OpenAI 兼容接口）====
# 想换模型只改这一行：doubao | deepseek | qwen | kimi
DEFAULT_MODEL=doubao

DOUBAO_API_KEY=你的火山方舟 API Key
# 火山方舟填接入点 ID（形如 ep-2024xxxx-xxxxx），也可以填模型名
DOUBAO_MODEL=ep-2024xxxx-xxxxx

# ==== 其它模型（可选，用到了再填）====
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_MODEL=qwen-plus

KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
